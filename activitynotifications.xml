<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade">
    <name>PLG_SYSTEM_ACTIVITYNOTIFICATIONS</name>
    <author>MundoPHPBB</author>
    <creationDate>2026-10</creationDate>
    <copyright>Copyright (C) 2026 MundoPHPBB</copyright>
    <license>GNU General Public License version 2 or later</license>
    <version>1.0.0</version>
    <description>PLG_SYSTEM_ACTIVITYNOTIFICATIONS_DESC</description>
    <namespace path="src">Mundophpbb\Plugin\System\ActivityNotifications</namespace>
    <files>
        <folder plugin="activitynotifications">services</folder>
        <folder>src</folder>
    </files>
    <media destination="plg_system_activitynotifications" folder="media">
        <folder>js</folder>
    </media>
    <languages>
        <language tag="en-GB">language/en-GB/plg_system_activitynotifications.ini</language>
        <language tag="en-GB">language/en-GB/plg_system_activitynotifications.sys.ini</language>
        <language tag="pt-BR">language/pt-BR/plg_system_activitynotifications.ini</language>
        <language tag="pt-BR">language/pt-BR/plg_system_activitynotifications.sys.ini</language>
    </languages>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field name="refresh_interval" type="number" default="20" min="10" max="300" label="PLG_SYSTEM_ACTIVITYNOTIFICATIONS_INTERVAL_LABEL" description="PLG_SYSTEM_ACTIVITYNOTIFICATIONS_INTERVAL_DESC" />
                <field name="show_toast" type="radio" default="1" class="btn-group btn-group-yesno" label="PLG_SYSTEM_ACTIVITYNOTIFICATIONS_TOAST_LABEL">
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                <field name="comments_only" type="radio" default="0" class="btn-group btn-group-yesno" label="PLG_SYSTEM_ACTIVITYNOTIFICATIONS_COMMENTS_ONLY_LABEL" description="PLG_SYSTEM_ACTIVITYNOTIFICATIONS_COMMENTS_ONLY_DESC">
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
            </fieldset>
        </fields>
    </config>
</extension>
